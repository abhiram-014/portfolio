# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Authentication Security
# ==========================================
# In production, provide a random 64-character secret
JWT_SECRET=your_super_secret_random_jwt_key_min_32_characters

# Initial Admin Credentials (used only on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere

# ==========================================
# Upload Limits
# ==========================================
UPLOAD_MAX_VIDEO_SIZE_MB=150
UPLOAD_MAX_IMAGE_SIZE_MB=15

# ==========================================
# Storage Driver (local | s3)
# ==========================================
STORAGE_DRIVER=local

# Optional: Cloud Object Storage (Cloudflare R2 / AWS S3 / Supabase)
# Set STORAGE_DRIVER=s3 to enable cloud uploads
S3_BUCKET=my-portfolio-bucket
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
CDN_BASE_URL=https://cdn.yourdomain.com

# Allowed CORS Origins (comma-separated, e.g. https://yourdomain.com)
ALLOWED_ORIGINS=*
